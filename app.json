{
  "expo": {
    "name": "BETRA",
    "slug": "BetTrackerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1B3D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1B3D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tobiadonadon.betra",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "BETRA needs camera access to scan your bet tickets for automatic data extraction.",
        "NSPhotoLibraryUsageDescription": "BETRA needs photo library access to scan bet tickets from your saved photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.betra.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1B3D"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "673b896b-b015-4862-9042-156f1d43bf68"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
